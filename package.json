{
  "name": "quickdiff",
  "displayName": "QuickDiff",
  "description": "A minimal, keyboard-first diff viewer for VS Code",
  "publisher": "abogoyavlensky",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abogoyavlensky/quickdiff"
  },
  "bugs": {
    "url": "https://github.com/abogoyavlensky/quickdiff/issues"
  },
  "keywords": [
    "diff",
    "git",
    "review",
    "keyboard",
    "changes"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#222F4A",
    "theme": "dark"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickdiff",
          "title": "QuickDiff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "quickdiff": [
        {
          "id": "quickdiff.files",
          "name": "Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "quickdiff.refresh",
        "title": "Refresh",
        "category": "QuickDiff",
        "icon": "$(refresh)"
      },
      {
        "command": "quickdiff.pickMode",
        "title": "Pick Mode",
        "category": "QuickDiff",
        "icon": "$(git-compare)"
      },
      {
        "command": "quickdiff.openAll",
        "title": "Open All Changes",
        "category": "QuickDiff",
        "icon": "$(list-flat)"
      },
      {
        "command": "quickdiff.nextFile",
        "title": "Next File",
        "category": "QuickDiff"
      },
      {
        "command": "quickdiff.prevFile",
        "title": "Previous File",
        "category": "QuickDiff"
      },
      {
        "command": "quickdiff.nextHunk",
        "title": "Next Change",
        "category": "QuickDiff"
      },
      {
        "command": "quickdiff.prevHunk",
        "title": "Previous Change",
        "category": "QuickDiff"
      },
      {
        "command": "quickdiff.openFile",
        "title": "Open Change",
        "category": "QuickDiff"
      },
      {
        "command": "quickdiff.installCli",
        "title": "Install qd Command",
        "category": "QuickDiff"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quickdiff.openFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "quickdiff.refresh",
          "when": "view == quickdiff.files",
          "group": "navigation@0"
        },
        {
          "command": "quickdiff.pickMode",
          "when": "view == quickdiff.files",
          "group": "navigation@1"
        },
        {
          "command": "quickdiff.openAll",
          "when": "view == quickdiff.files",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "QuickDiff",
      "properties": {
        "quickdiff.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Base branch for branch mode. When empty, QuickDiff uses `main` if it exists, otherwise `master`, otherwise asks."
        },
        "quickdiff.singleDiffEditor": {
          "type": "boolean",
          "default": false,
          "description": "Keep only one QuickDiff diff open. Opening a change closes the other QuickDiff diff tabs, even pinned ones, in every editor group. Tabs with unsaved edits stay open. The multi-diff editor from Open All is not affected."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "quickdiff.files",
        "contents": "Open a folder inside a git repository to see changes.",
        "when": "quickdiff.noRepository"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "mocha": "^11.7.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
